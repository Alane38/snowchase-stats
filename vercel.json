{
  "git": {
    "deploymentEnabled": {
      "data": false
    }
  },
  "crons": [
    {
      "path": "/api/snapshot",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "api/snapshot.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/snapshot",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=1800, stale-while-revalidate=1800"
        }
      ]
    },
    {
      "source": "/(admin|admin.html|api/admin)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
